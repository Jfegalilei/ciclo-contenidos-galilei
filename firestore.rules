rules_version = '2';

// Quien puede tocar el calendario: cualquier cuenta de Google cuyo correo
// termine en el dominio de Galilei y este verificado. Nadie mas lee ni
// escribe, aunque tenga el enlace de la pagina.
//
// El dominio esta escrito aqui Y en config.js. Si cambia, cambialo en los
// dos: este archivo es el que manda de verdad; config.js solo decide que
// mensaje ve la persona antes de entrar.
//
// Se publica con:  firebase deploy --only firestore:rules
// o pegando el contenido en la consola, en Firestore > Reglas.

service cloud.firestore {
  match /databases/{database}/documents {

    function esDeGalilei() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower().matches('.*@galileilearning[.]com');
    }

    // El ciclo: las 28 casillas de la plantilla.
    match /plantilla/{id} {
      allow read, write: if esDeGalilei();
    }

    // La libreria de retos y anuncios reutilizables.
    match /libreria/{id} {
      allow read, write: if esDeGalilei();
    }

    // Un documento por vuelta del ciclo, con las marcas de envio.
    match /envios/{vuelta} {
      allow read, write: if esDeGalilei();
    }

    // Duracion del ciclo, compartida por todos.
    match /config/{clave} {
      allow read, write: if esDeGalilei();
    }

    // Estrellas de participacion de cada reto. Las escribe Chatmanager con la
    // cuenta de servicio (que no pasa por estas reglas); la pagina solo lee.
    match /calificaciones/{id} {
      allow read: if esDeGalilei();
      allow write: if false;
    }

    // ---- Generador de premios semanales (repo premios-semanales-galilei).
    // Comparte proyecto con el calendario. Por ahora SIN login: cualquiera con
    // el enlace lee y edita. No se puede borrar, solo se aceptan los campos del
    // catalogo y el recorte (WebP en data URI) tiene tope de tamano.
    match /premios/{id} {
      allow read: if true;
      allow create, update: if id.matches('^[a-z0-9-]{1,48}$')
        && request.resource.data.keys().hasOnly(['etiqueta', 'desglose', 'unidadMonto',
             'valor', 'categoria', 'alias', 'prioridad', 'ignorar', 'imagen'])
        && (!('imagen' in request.resource.data)
            || (request.resource.data.imagen is string
                && request.resource.data.imagen.size() < 950000));
      allow delete: if false;
    }

    // Posiciones del personaje colocadas a mano: un solo documento. Y la rifa
    // de cada loteria del reporte para clientes por mes (`loteria-2026-09` la
    // de Galilei, `loteriaResenas-…` la de resenas, `loteriaAuteco-…` la propia
    // de Auteco; sin mes, los documentos viejos): solo los campos de la tarjeta
    // y la foto del premio (WebP en data URI) con tope de tamano. Sin borrar.
    match /premiosConfig/{clave} {
      allow read: if true;
      allow create, update: if (clave == 'posiciones'
          && request.resource.data.keys().hasOnly(['posiciones']))
        || (clave.matches('^loteria(Resenas|Auteco)?(-[0-9]{4}-[0-9]{2})?$')
          && request.resource.data.keys().hasOnly(['mes', 'premio', 'ganador', 'empresa', 'live', 'foto'])
          && (!('foto' in request.resource.data)
              || (request.resource.data.foto is string
                  && request.resource.data.foto.size() < 950000)));
    }

    // Logos de los clientes (ya en blanco), uno por compania, su nombre escrito
    // a mano y `ocultos`: lo que se apago en «Que mostrar» del reporte (training,
    // reviews, metas; true = apagado), igual para todo el equipo. Sin borrar:
    // para quitar un logo se deja `logo` vacio.
    match /clientes/{id} {
      allow read: if true;
      allow create, update: if id.matches('^[a-z0-9-]{1,48}$')
        && request.resource.data.keys().hasOnly(['nombre', 'logo', 'ocultos'])
        && (!('logo' in request.resource.data)
            || (request.resource.data.logo is string
                && request.resource.data.logo.size() < 300000))
        && (!('ocultos' in request.resource.data)
            || (request.resource.data.ocultos is map
                && request.resource.data.ocultos.keys().hasOnly(['training', 'reviews', 'metas'])));
      allow delete: if false;
    }

    // Datos del reporte para clientes: los CSV de las queries, partidos por
    // query y mes (`conocimiento-2026-09-0`, `premios-fijo-0`, `metas-2026-10-0`...). Traen nombres
    // de empleados y datos de los clientes. POR AHORA SIN LOGIN, como el resto
    // del generador: cualquiera con el enlace lee y sube. Para cerrarlos a
    // Galilei, cambiar `true` por `esDeGalilei()` en las dos lineas. Sin borrar:
    // un trozo que sobra se deja vacio.
    match /reporteDatos/{id} {
      allow read: if true;
      allow create, update: if id.matches('^(conocimiento|premios|reviews|auteco|metas)-(fijo|[0-9]{4}-[0-9]{2})-[0-9]+$')
        && request.resource.data.keys().hasOnly(['columnas', 'filas', 'subido', 'por'])
        && request.resource.data.filas is string
        && request.resource.data.filas.size() < 900000;
    }

    // Todo lo demas queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
